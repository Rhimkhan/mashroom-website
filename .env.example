# ===============================================================
# AKHIL FOODS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and update with your credentials
# DO NOT COMMIT REAL SECRETS OR SENSITIVE API KEYS TO VERSION CONTROL
# ===============================================================

# ---------------------------------------------------------------
# 1. Brand & Store Identity
# ---------------------------------------------------------------

# Public brand name displayed across header, footer, page titles, and invoices
NEXT_PUBLIC_BRAND_NAME="AKHIL FOODS"

# Brand tagline / motto displayed on banners, hero section, and metadata
NEXT_PUBLIC_BRAND_TAGLINE="Great Food, Better Life"

# 12-digit international WhatsApp number for customer support and order confirmations (e.g. 91XXXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER="916386423865"

# Canonical base URL for your application (use http://localhost:3000 locally, https://yourdomain.com in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ---------------------------------------------------------------
# 2. Supabase Configuration (Database, Authentication & Storage)
# ---------------------------------------------------------------

# Public URL of your Supabase project (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Public anon/public key for client-side queries (safe to expose in client code)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Privileged service_role key for administrative operations (STRICTLY SERVER-SIDE, NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"


# ---------------------------------------------------------------
# 3. Payment Gateway: UPI Direct & Razorpay
# ---------------------------------------------------------------

# Virtual Payment Address (VPA) for receiving direct UPI bank transfers via dynamic QR codes
NEXT_PUBLIC_UPI_ID="your-upi-id@okhdfcbank"

# Public Razorpay Key ID (rzp_test_... or rzp_live_...). If omitted, online card checkout is hidden automatically
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Private Razorpay Key Secret used for server-side cryptographic signature validation (STRICTLY SERVER-SIDE)
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

# Secret token configured in Razorpay Webhooks dashboard to verify incoming payment webhook payloads
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"


# ---------------------------------------------------------------
# 4. Email Notification Service (Resend)
# ---------------------------------------------------------------

# Resend API key for automated transactional order confirmations (get from resend.com/api-keys)
RESEND_API_KEY="re_your_resend_api_key_here"

# "From" sender header for outgoing customer order receipts (requires verified domain on Resend)
EMAIL_FROM="Akhil Foods <orders@yourdomain.com>"

# Fallback sender email address matching your verified Resend sending identity
RESEND_FROM_EMAIL="Akhil Foods <orders@yourdomain.com>"

# Admin email inbox where new order alert notifications should be dispatched
ADMIN_NOTIFICATION_EMAIL="admin@yourdomain.com"


# ---------------------------------------------------------------
# 5. Admin Portal Authentication (Server-side Only)
# ---------------------------------------------------------------

# Password required by store staff to authenticate into the /admin management portal
ADMIN_PASSWORD="your-strong-admin-password-here"

# Cryptographically random string (at least 32 characters) used to sign secure admin session cookies
ADMIN_SESSION_SECRET="your-strong-random-session-secret-at-least-32-chars"


# ---------------------------------------------------------------
# 6. Analytics, Contact & Verification (Optional)
# ---------------------------------------------------------------

# Customer support and wholesale inquiry contact email address
NEXT_PUBLIC_CONTACT_EMAIL="contact@akhilfoods.com"

# Google Search Console HTML meta verification token string
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your-google-verification-code"

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Official brand Instagram profile link
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/akhilfoods"

# Official brand Facebook page link
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/akhilfoods"
