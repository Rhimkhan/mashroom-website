# ===============================================================
# AKHIL FOODS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and update with your credentials
# ===============================================================

# 1. Brand & Store Identity
NEXT_PUBLIC_BRAND_NAME="AKHIL FOODS"
NEXT_PUBLIC_BRAND_TAGLINE="Great Food, Better Life"
NEXT_PUBLIC_WHATSAPP_NUMBER="916386423865"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 2. Supabase Configuration (Database, Authentication & Storage)
# Obtain from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# 3. Payment Gateway: UPI Direct & Razorpay
# UPI payments (direct bank transfer via QR code and UTR submission)
NEXT_PUBLIC_UPI_ID="your-upi-id@okhdfcbank"

# Optional: Razorpay Online Payment Gateway (If left empty, online payment is hidden and only COD & UPI are shown)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET=""

# 4. Email Notification Service (Resend)
# Used to dispatch order notifications to customer and store admin
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="Akhil Foods <orders@yourdomain.com>"
RESEND_FROM_EMAIL="Akhil Foods <orders@yourdomain.com>"
ADMIN_NOTIFICATION_EMAIL="admin@yourdomain.com"

# 5. Admin Portal Authentication (Server-side Only)
ADMIN_PASSWORD="your-strong-admin-password-here"
ADMIN_SESSION_SECRET="your-strong-random-session-secret-at-least-32-chars"

# 6. Analytics, Contact & Verification (Optional)
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
